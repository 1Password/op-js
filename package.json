{
	"name": "@1password/op-js",
	"version": "0.1.13",
	"description": "A typed JS wrapper for the 1Password CLI",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist/"
	],
	"repository": "github:1Password/op-js",
	"license": "MIT",
	"scripts": {
		"build": "pnpm run clean && node esbuild.mjs",
		"build:prod": "pnpm run clean && NODE_ENV=production node esbuild.mjs",
		"clean": "rm -rf dist",
		"eslint": "eslint -c .eslintrc.json 'src/*.ts'",
		"prepare": "husky install",
		"prettier": "prettier --check 'src/*.ts'",
		"test": "jest",
		"typecheck": "tsc -p tsconfig.release.json --noEmit",
		"watch": "pnpm run build --watch"
	},
	"prettier": "@1password/prettier-config",
	"lint-staged": {
		"src/*.ts": [
			"prettier --write",
			"eslint -c .eslintrc.json --fix"
		]
	},
	"devDependencies": {
		"@1password/eslint-config": "^5.0.0",
		"@1password/prettier-config": "^1.1.3",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.18.0",
		"@types/semver": "^7.5.8",
		"@typescript-eslint/eslint-plugin": "^8.46.0",
		"@typescript-eslint/parser": "^8.46.0",
		"esbuild": "^0.25.10",
		"eslint": "^8.57.0",
		"husky": "^9.1.7",
		"jest": "^30.2.0",
		"lint-staged": "^15.2.2",
		"prettier": "^3.6.2",
		"prettier-plugin-organize-imports": "^4.3.0",
		"ts-jest": "^29.4.4",
		"typescript": "5.9.2"
	},
	"dependencies": {
		"lookpath": "^1.2.2",
		"semver": "^7.6.2"
	},
	"engines": {
		"node": "^22.18.0"
	},
	"packageManager": "pnpm@10.2.0"
}
