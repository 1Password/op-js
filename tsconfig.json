{
	"compilerOptions": {
		"target": "ESNext",
		"module": "AMD",
		"allowJs": true,
		"esModuleInterop": true,
		"moduleResolution": "Node",
		"resolveJsonModule": true,
		"noImplicitAny": false,
		"baseUrl": ".",
		"types": [
			"node",
			"jest"
		],
	},
	"include": [
		"src/**/*.ts",
		"examples/**/*.ts",
		"jest.config.ts"
	],
}
